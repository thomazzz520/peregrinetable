{
  "name": "peacock-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:data": "esbuild scripts/check-data.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-check.mjs --log-level=error && node node_modules/.tmp-check.mjs",
    "check:guest": "esbuild scripts/check-guest.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-guest.mjs --log-level=error && node node_modules/.tmp-guest.mjs",
    "check:rules": "esbuild scripts/check-rules.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-rules.mjs --log-level=error && node node_modules/.tmp-rules.mjs",
    "check:tones": "esbuild scripts/check-tones.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-tones.mjs --log-level=error && node node_modules/.tmp-tones.mjs",
    "check:news": "esbuild scripts/check-news.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-news.mjs --log-level=error && node node_modules/.tmp-news.mjs",
    "check:menu": "esbuild scripts/check-menu.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-menu.mjs --log-level=error && node node_modules/.tmp-menu.mjs",
    "check:series": "esbuild scripts/check-series.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-series.mjs --log-level=error && node node_modules/.tmp-series.mjs",
    "check:render": "esbuild scripts/check-render.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp-render.mjs --log-level=error && node node_modules/.tmp-render.mjs",
    "check:weather": "esbuild scripts/check-weather.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-weather.mjs --log-level=error && node node_modules/.tmp-weather.mjs",
    "dev:api": "esbuild server/dev.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.peacock-api.mjs --log-level=error && node node_modules/.peacock-api.mjs",
    "hash-password": "esbuild scripts/hash-password.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.peacock-hash.mjs --log-level=error && node node_modules/.peacock-hash.mjs",
    "_argv": "node node_modules/.peacock-argv.mjs",
    "check": "npm run check:data && npm run check:guest && npm run check:rules && npm run check:tones && npm run check:weather && npm run check:news && npm run check:menu && npm run check:series"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "0.185.1",
    "troika-three-text": "^0.52.4",
    "framer-motion": "^11.11.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
